# Postgres (Supabase project nuevo o Neon - lo que elijas)
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/db?sslmode=require"

# Secret para firmar las cookies de sesión (JWT HS256)
# Generar con: openssl rand -base64 32
AUTH_SECRET="pon-aqui-un-string-aleatorio-largo-de-al-menos-32-chars"

# Password del admin inicial (solo se usa en el seed - borrar después)
ADMIN_EMAIL="mininipropiedades@gmail.com"
ADMIN_PASSWORD="cambiar-en-el-seed"
